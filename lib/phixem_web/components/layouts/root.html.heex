<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title>Phixem</.live_title>
    <link rel="icon" type="image/png" href={~p"/favicon.png"} />
    <link rel="apple-touch-icon" href={~p"/favicon.png"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <style>
      :root { color-scheme: dark; }
      html, body { min-height: 100%; }
      body {
        position: relative;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        font-family: Georgia, "Times New Roman", serif;
        margin: 1.25rem 1.25rem 0;
        padding-right: 11rem;
        line-height: 1.4;
        background: #111;
        color: #eee;
      }
      .page { flex: 1 0 auto; padding-bottom: 1.5rem; }
      .site-foot {
        flex: 0 0 6.5rem;
        height: 6.5rem;
        margin: 0 -1.25rem 0 calc(-1.25rem);
        width: calc(100% + 2.5rem + 11rem);
        background-color: #000;
        background-image: url("/images/football.png");
        background-repeat: repeat-x;
        background-position: center bottom;
        background-size: auto 6.5rem;
      }
      .hero-art {
        position: absolute;
        top: -2.15rem;
        right: -2.4rem;
        height: 12rem;
        width: 12rem;
        object-fit: cover;
        object-position: 82% 42%;
        pointer-events: none;
      }
      h1 {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.45rem 1.25rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin: 0 0 0.35rem;
      }
      .header-stats {
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: 0;
        color: #cfc;
      }
      .muted { color: #888; font-size: 0.95rem; margin: 0 0 1rem; max-width: 52rem; }
      .tabs { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1.25rem 0 1rem; }
      .tab {
        font: inherit;
        color: #ccc;
        background: #1c1c1c;
        border: 1px solid #333;
        padding: 0.35rem 0.8rem;
        cursor: pointer;
      }
      a.tab { text-decoration: none; display: inline-block; }
      .tab.on { color: #111; background: #cfc; border-color: #9f9; }
      .perfect-form, .entry-form { margin-top: 1.25rem; max-width: 36rem; }
      .matchup-pick {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1rem;
        padding: 0.55rem 0;
        border-bottom: 1px solid #2a2a2a;
      }
      .matchup-pick label { display: flex; align-items: center; gap: 0.35rem; margin: 0; }
      .matchup-label { min-width: 6.5rem; font-weight: 600; }
      .perfect-form button, .entry-form button { margin-top: 1rem; }
      button:disabled { opacity: 0.45; cursor: not-allowed; }
      .board {
        position: relative;
        z-index: 1;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior-x: contain;
        width: calc(100% + 2.5rem + 11rem);
        max-width: none;
        margin-left: -1.25rem;
      }
      .board::-webkit-scrollbar { height: 12px; }
      .board::-webkit-scrollbar-track { background: #1a1a1a; }
      .board::-webkit-scrollbar-thumb { background: #666; border-radius: 6px; }
      table { border-collapse: collapse; font-size: 0.82rem; min-width: 100%; }
      @media (max-width: 720px) {
        body {
          margin: 0.85rem 0.7rem 0;
          padding-right: 5.75rem;
        }
        .hero-art {
          height: 5.25rem;
          width: 5.25rem;
          top: -0.35rem;
          right: -0.35rem;
        }
        .site-foot {
          margin: 0 -0.7rem 0 calc(-0.7rem);
          width: calc(100% + 1.4rem + 5.75rem);
        }
        .board {
          width: calc(100% + 1.4rem + 5.75rem);
          margin-left: -0.7rem;
        }
      }
      th, td {
        border: 1px solid #333;
        padding: 0.35rem 0.45rem;
        white-space: nowrap;
        text-align: center;
      }
      thead th { background: #1a1a1a; font-weight: 600; }
      tbody th { text-align: left; background: #181818; }
      tr.winners th, tr.winners td { background: #243024; color: #cfc; }
      form label { display: block; margin: 1rem 0; }
      form input[type="password"],
      form input[type="text"],
      form input[type="number"],
      form input[type="date"],
      form textarea {
        display: block;
        margin-top: 0.35rem;
        padding: 0.35rem 0.5rem;
        font: inherit;
        width: min(32rem, 100%);
      }
      .admin-error { color: #f99; }
      .admin-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; margin: 1rem 0 1.5rem; }
      .admin-create, .admin-weeks { margin-top: 1.75rem; }
    </style>
  </head>
  <body>
    <img src={~p"/images/runner.png"} alt="" class="hero-art" />
    <div class="page">{@inner_content}</div>
    <footer class="site-foot" aria-hidden="true"></footer>
  </body>
</html>
